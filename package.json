{
  "name": "nexconnect",
  "version": "1.0.0",
  "private": true,
  "description": "NexConnect — WhatsApp Engine for NexBot ecosystem",
  "author": "Orbitmind",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev:api": "turbo run dev --filter=@nexconnect/api",
    "dev:worker": "turbo run dev --filter=@nexconnect/worker",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @nexconnect/database prisma:generate",
    "db:migrate": "pnpm --filter @nexconnect/database prisma:migrate",
    "db:push": "pnpm --filter @nexconnect/database prisma:push",
    "db:seed": "pnpm --filter @nexconnect/database prisma:seed",
    "db:studio": "pnpm --filter @nexconnect/database prisma:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/static": "^9.0.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^8.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "6.19.2",
    "@slack/events-api": "^3.0.1",
    "@slack/web-api": "^7.15.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "discord.js": "^14.26.4",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "twilio": "^6.0.0",
    "ulid": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.21",
    "@types/bcrypt": "^5.0.2",
    "@types/supertest": "^6.0.0",
    "ignore-loader": "^0.1.2",
    "oxlint": "^1.58.0",
    "prisma": "6.19.2",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.9.3",
    "vitest": "^4.1.2",
    "webpack": "^5.105.4",
    "webpack-node-externals": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.14.0",
      "prisma": "^6.19.0",
      "@prisma/client": "^6.19.0"
    }
  }
}
