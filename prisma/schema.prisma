generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum InstanceStatus {
  CREATED
  CONNECTING
  CONNECTED
  DISCONNECTED
  BANNED
}

enum ConnectionType {
  QR_CODE
  PAIRING_CODE
  WABA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  VCARD
  BUTTON_REPLY
  LIST_REPLY
  REACTION
  POLL
  STATUS_REPLY
  CALL_MISSED
  TEMPLATE
  UNKNOWN
}

enum MessageStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD_LETTER
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
}

enum ScheduledMessageStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum ProviderType {
  BAILEYS
  META_WHATSAPP_CLOUD
  META_INSTAGRAM
  META_MESSENGER
  TWILIO_SMS
  TWILIO_WHATSAPP
  TWILIO_VOICE
  TWILIO_VERIFY
}

enum ProviderCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

enum TemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum InboundEventStatus {
  RECEIVED
  PROCESSED
  DISCARDED
  FAILED
}

// ─── Models ─────────────────────────────────────────────

model Tenant {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  plan      TenantPlan @default(FREE)
  settings  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  apiKeys             ApiKey[]
  instances           Instance[]
  webhooks            Webhook[]
  providerCredentials ProviderCredential[]
  messageTemplates    MessageTemplate[]
  inboundEvents       InboundWebhookEvent[]

  @@map("tenants")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  prefix     String
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Instance {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  name               String
  phoneNumber        String?        @map("phone_number")
  status             InstanceStatus @default(CREATED)
  connectionType     ConnectionType @map("connection_type")
  settings           Json           @default("{}")
  authStateEncrypted Bytes?         @map("auth_state_encrypted")
  podId              String?        @map("pod_id")
  healthScore        Int            @default(100) @map("health_score")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages          Message[]
  events            Event[]
  webhooks          Webhook[]
  mediaAssets       MediaAsset[]
  scheduledMessages ScheduledMessage[]
  numberHealth      NumberHealth?
  cronJobs          CronJob[]
  blacklist         Blacklist[]
  whitelist         Whitelist[]
  credentials       ProviderCredential[]
  externalMappings  ExternalMessageMapping[]

  @@index([tenantId, status])
  @@map("instances")
}

model Webhook {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId        String  @map("instance_id") @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  name              String
  url               String
  testUrl           String? @map("test_url")
  enabled           Boolean @default(true)
  testMode          Boolean @default(false) @map("test_mode")
  events            String[]
  secretEncrypted   String  @map("secret_encrypted")
  headers           Json?
  retryMaxAttempts  Int     @default(5) @map("retry_max_attempts")
  retryBackoffBase  Float   @default(2.5) @map("retry_backoff_base")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  instance   Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model Message {
  id           String           @id
  instanceId   String           @map("instance_id") @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  waMessageId  String?          @unique @map("wa_message_id")
  provider     ProviderType     @default(BAILEYS)
  externalId   String?          @map("external_id")
  fromAddress  String?          @map("from_address")
  toAddress    String?          @map("to_address")
  direction    MessageDirection
  type         MessageType
  content      Json
  status       MessageStatus    @default(PENDING)
  errorCode    String?          @map("error_code")
  errorReason  String?          @map("error_reason")
  metadata     Json?
  sentAt       DateTime?        @map("sent_at")
  deliveredAt  DateTime?        @map("delivered_at")
  readAt       DateTime?        @map("read_at")
  failedAt     DateTime?        @map("failed_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  @@index([instanceId, direction, createdAt(sort: Desc)])
  @@index([provider, externalId])
  @@map("messages")
}

model Event {
  id         String   @id
  tenantId   String   @map("tenant_id") @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  type       String
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  instance   Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, type, createdAt])
  @@map("events")
}

model WebhookDelivery {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String                @map("event_id")
  webhookId    String                @map("webhook_id") @db.Uuid
  attempt      Int
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?                  @map("response_code")
  responseBody String?               @map("response_body")
  durationMs   Int?                  @map("duration_ms")
  createdAt    DateTime              @default(now()) @map("created_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("webhook_deliveries")
}

model MediaAsset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  instanceId    String    @map("instance_id") @db.Uuid
  messageId     String?   @map("message_id")
  type          MediaType
  r2Key         String    @map("r2_key")
  url           String
  sizeBytes     Int       @map("size_bytes")
  mimeType      String    @map("mime_type")
  transcription String?
  createdAt     DateTime  @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("media_assets")
}

model NumberHealth {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId   String   @unique @map("instance_id") @db.Uuid
  score        Int
  responseRate Float    @map("response_rate")
  readRate     Float    @map("read_rate")
  bounceRate   Float    @map("bounce_rate")
  volumeScore  Float    @map("volume_score")
  calculatedAt DateTime @map("calculated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("number_health")
}

model ScheduledMessage {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String                 @map("instance_id") @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  payload    Json
  status     ScheduledMessageStatus @default(SCHEDULED)
  sendAt     DateTime               @map("send_at")
  cron       String?
  sentAt     DateTime?              @map("sent_at")
  failedAt   DateTime?              @map("failed_at")
  attempt    Int                    @default(0)
  createdAt  DateTime               @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("scheduled_messages")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model CronJob {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId     String   @map("instance_id") @db.Uuid
  name           String
  cronExpression String   @map("cron_expression")
  to             String
  type           String
  content        Json
  timezone       String   @default("America/Sao_Paulo")
  active         Boolean  @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, active])
  @@map("cron_jobs")
}

model Broadcast {
  id              String   @id
  tenantId        String   @map("tenant_id") @db.Uuid
  instanceIds     String[] @map("instance_ids")
  totalRecipients Int      @map("total_recipients")
  type            String
  content         Json
  status          String   @default("queued")
  sentCount       Int      @default(0) @map("sent_count")
  failedCount     Int      @default(0) @map("failed_count")
  strategy        String   @default("round_robin")
  sendWindow      Json?    @map("send_window")
  variants        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("broadcasts")
}

model Blacklist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  phone      String
  reason     String
  failCount  Int      @default(0) @map("fail_count")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, phone])
  @@map("blacklist")
}

model Whitelist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, phone])
  @@map("whitelist")
}

model SandboxSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  status     String   @default("active")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([tenantId])
  @@map("sandbox_sessions")
}

// ─── Provider credentials (Meta / Twilio) ──────────────
//
// Stores per-tenant credentials for external messaging providers.
// Sensitive material (access_token, auth_token, signing_secret) is stored
// in `credentialsEncrypted` as AES-256-GCM encrypted bytes.
// Non-sensitive identifiers (business_account_id, phone_number_id,
// account_sid) live in dedicated columns so we can query by them
// without decrypting.
model ProviderCredential {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  instanceId           String?                  @map("instance_id") @db.Uuid
  provider             ProviderType
  displayName          String                   @map("display_name")
  credentialsEncrypted Bytes                    @map("credentials_encrypted")
  externalAccountId    String?                  @map("external_account_id")
  externalPhoneId      String?                  @map("external_phone_id")
  phoneNumber          String?                  @map("phone_number")
  webhookVerifyToken   String?                  @map("webhook_verify_token")
  webhookCallbackUrl   String?                  @map("webhook_callback_url")
  status               ProviderCredentialStatus @default(ACTIVE)
  lastUsedAt           DateTime?                @map("last_used_at")
  lastRotatedAt        DateTime?                @map("last_rotated_at")
  expiresAt            DateTime?                @map("expires_at")
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance  Instance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  templates MessageTemplate[]

  @@index([tenantId, provider])
  @@index([externalAccountId, provider])
  @@index([externalPhoneId])
  @@map("provider_credentials")
}

// Message templates (Meta WhatsApp / Twilio Content).
// Meta requires pre-approved templates to initiate conversations
// outside the 24h window. Twilio Content API templates are referenced
// by ContentSid.
model MessageTemplate {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  credentialId       String           @map("credential_id") @db.Uuid
  externalTemplateId String?          @map("external_template_id")
  name               String
  language           String
  category           TemplateCategory
  components         Json
  status             TemplateStatus   @default(PENDING)
  rejectionReason    String?          @map("rejection_reason")
  qualityScore       String?          @map("quality_score")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential ProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, name, language])
  @@index([tenantId, status])
  @@map("message_templates")
}

// Bidirectional mapping between provider-native message IDs and
// internal ULID message IDs, so status callbacks (delivered/read/failed)
// can reconcile with the correct Message row.
model ExternalMessageMapping {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  instanceId         String       @map("instance_id") @db.Uuid
  provider           ProviderType
  externalMessageId  String       @map("external_message_id")
  internalMessageId  String       @map("internal_message_id")
  createdAt          DateTime     @default(now()) @map("created_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([provider, externalMessageId])
  @@index([internalMessageId])
  @@index([tenantId, provider])
  @@map("external_message_mappings")
}

// Raw inbound webhook event log (Meta / Twilio).
// Persisted BEFORE any processing so we can replay / debug.
// rawPayload stores the exact body for audit + signature re-verification.
model InboundWebhookEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?            @map("tenant_id") @db.Uuid
  provider    ProviderType
  eventType   String             @map("event_type")
  externalId  String?            @map("external_id")
  headers     Json
  rawPayload  Json               @map("raw_payload")
  status      InboundEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime           @default(now()) @map("received_at")
  processedAt DateTime?          @map("processed_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([provider, receivedAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([externalId])
  @@map("inbound_webhook_events")
}
