# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://nexconnect:nexconnect@localhost:5432/nexconnect?schema=public"

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─── API ─────────────────────────────────────────────────
API_PORT=3100
API_HOST="0.0.0.0"
API_PREFIX="v1"
API_CORS_ORIGINS="http://localhost:3000"

# ─── Worker ──────────────────────────────────────────────
WORKER_MAX_INSTANCES_PER_POD=30
WORKER_POD_ID="pod-1"

# ─── Auth ────────────────────────────────────────────────
API_KEY_HASH_ROUNDS=12
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"

# ─── Inter-Pod JWT (RS256) ───────────────────────────────
INTER_POD_PRIVATE_KEY=""
INTER_POD_PUBLIC_KEY=""

# ─── Cloudflare R2 ──────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nexconnect-media"
R2_PUBLIC_URL=""

# ─── STT (Speech-to-Text) ───────────────────────────────
STT_PROVIDER="whisper"
OPENAI_API_KEY=""
ASSEMBLYAI_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# ─── Webhook ────────────────────────────────────────────
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF_BASE=2.5

# ─── Encryption ─────────────────────────────────────────
ENCRYPTION_KEY="change-me-32-bytes-hex-key-here!"

# ─── Observability ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL="info"

# ─── NexBot Integration ─────────────────────────────────
NEXBOT_WEBHOOK_URL=""
NEXBOT_CHANNEL_SECRET=""

# ─── Meta Graph API (WhatsApp Cloud / Instagram / Messenger) ─
# Used by apps/api Meta module. Per-tenant credentials live in
# provider_credentials (encrypted); the values below are defaults /
# app-level settings.
META_GRAPH_API_VERSION="v21.0"
META_GRAPH_API_BASE_URL="https://graph.facebook.com"
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_WEBHOOK_CALLBACK_PATH="/v1/webhooks/meta"
META_DEFAULT_ACCESS_TOKEN=""
META_REQUEST_TIMEOUT_MS=30000

# ─── Twilio ──────────────────────────────────────────────
# Per-tenant credentials live in provider_credentials (encrypted);
# the values below are fallbacks / shared infra settings.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_APPLICATION_SID=""
TWILIO_WEBHOOK_CALLBACK_PATH="/v1/webhooks/twilio"
TWILIO_STATUS_CALLBACK_URL=""
TWILIO_VALIDATE_SIGNATURE="true"
TWILIO_REQUEST_TIMEOUT_MS=30000

# ─── Telegram ────────────────────────────────────────────
# Per-tenant credentials live in provider_credentials (encrypted).
# These are app-level defaults / fallbacks for development.
TELEGRAM_API_BASE_URL="https://api.telegram.org"
TELEGRAM_WEBHOOK_CALLBACK_PATH="/v1/webhooks/telegram"
TELEGRAM_REQUEST_TIMEOUT_MS=30000

# ─── Discord ─────────────────────────────────────────────
DISCORD_API_BASE_URL="https://discord.com/api/v10"
DISCORD_INTERACTIONS_CALLBACK_PATH="/v1/webhooks/discord/interactions"
DISCORD_REQUEST_TIMEOUT_MS=30000

# ─── Slack ───────────────────────────────────────────────
SLACK_API_BASE_URL="https://slack.com/api"
SLACK_EVENTS_CALLBACK_PATH="/v1/webhooks/slack/events"
SLACK_INTERACTIVITY_CALLBACK_PATH="/v1/webhooks/slack/interactivity"
SLACK_COMMANDS_CALLBACK_PATH="/v1/webhooks/slack/commands"
SLACK_REQUEST_TIMEOUT_MS=30000
SLACK_OAUTH_REDIRECT_URI=""
